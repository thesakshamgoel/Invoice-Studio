rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in Google ID can read/write only its own data (profile + invoice history).
    match /users/{docId} {
      allow read, write: if request.auth != null && docId == 'google_' + request.auth.uid;
      match /invoices/{invId} {
        allow read, write: if request.auth != null && docId == 'google_' + request.auth.uid;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
